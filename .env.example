# ------------------------------------------------------------------ ERP ---
ERP_BASE_URL=https://10.1.1.220
ERP_PATH=/api/comercial/v10/pedidoVenda
ERP_EMPRESA=4
ERP_TOKEN=eyJhbGciOiJFUzI1NiJ9.COLE_SEU_TOKEN_AQUI
# Certificado autoassinado no servidor do ERP -> true
ERP_TLS_INSECURE=true
ERP_TIMEOUT_MS=60000
ERP_PAGINACAO=200
ERP_MAX_PAGINAS=200

# -------------------------------------------------------------- Painel ---
PORT=2000
TZ_PAINEL=America/Sao_Paulo
# Janela de consulta: hoje - N dias .. hoje
DIAS_RETROATIVOS=60
# Intervalo do GET principal (minutos)
POLL_INTERVALO_MIN=5
# Intervalo da consulta anual (KPIs de ano/mês/dia). Aumente para 30 ou 60
# se quiser reduzir a carga no ERP.
ANO_INTERVALO_MIN=5

# ------------------------------------------- Regras de negócio (KPIs) ---
# 0-Digitado 1-Listado 2-Liberado 3-Sel.Parcial 4-Sel.Total
# 5-Fat.Parcial 6-Fat.Total 7-Transmitido 8-Bloqueado 9-Cancelado
SIT_FATURADO=6
SIT_ABERTO=0,1,2,3,4,5,8
SIT_DISPONIVEL=2

# Situações que NÃO aparecem na tabela (os KPIs continuam contando todas).
# Padrão: 5-Faturado Parcial, 6-Faturado Total e 9-Cancelado.
# Para manter os parcialmente faturados na grid, use: SIT_OCULTAR_TABELA=6,9
SIT_OCULTAR_TABELA=5,6,9

# Dias exibidos no gráfico "Ritmo de emissão" (7 a 90).
DIAS_SERIE=30
